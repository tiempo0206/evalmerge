{
  "name": "@evalmerge/automerge-review",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build web --config vite.config.ts --outDir ../dist --emptyOutDir",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "demo": "node src/demo.ts",
    "dev": "vite web --config vite.config.ts --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.1"
  }
}
